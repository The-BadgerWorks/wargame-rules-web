---
// AI-Assisted: Claude Code (model: claude-opus-5) - Points and cost-bearing wargear (task T028;
// FR-011, FR-012, FR-014, US2 acceptance scenarios 4, 5 and 7).
//
// AI-Assisted note (model: Claude Sonnet 5, 005-rules-web-enrichment-display task T010): added
// `showWargearFallback`. This flat, cost-only table is what a unit shows when its bundle entry
// carries no full wargear option structure (FR-009); when it does, the unit page renders
// WargearOptions.astro instead and passes `showWargearFallback={false}` here so the same choices
// never appear twice (FR-008). The prop defaults to `true`, so this component's behavior for every
// existing call site - and any future one that does not pass it - is unchanged.
//
// AI-Assisted note (model: Claude Sonnet 5, prose-composition-wargear branch): the unit-size
// points table this component used to render is GONE - it moved into UnitComposition.astro, which
// now reads the same `datasheetCosts`/`datasheetCostTiers` rows as prose lines alongside the
// unit's composition ("one home for unit sizes", per the operator's redesign). This component's
// remaining and ONLY responsibility is the flat, cost-bearing wargear fallback for a datasheet
// with no full option-group structure (FR-009). The two decisions still worth stating about it:
//
// 1. FR-014's "visibly marked" is taken literally, THERE, for the same reason it was here before:
//    an unverified row gets a badge of its own. That logic now lives in UnitComposition.astro,
//    since the size/points rows are what it was ever qualifying.
// 2. The wargear section is OMITTED, not emptied, for a datasheet with no cost-bearing options
//    (scenario 4, and the Edge Cases: "the corresponding section is simply omitted rather than
//    shown empty").
import strings from '../chrome-strings.json';
import type { DatasheetWargearOption } from '../data/bundle.ts';

interface Props {
  wargearOptions: readonly DatasheetWargearOption[];
  showWargearFallback?: boolean;
}

const { wargearOptions, showWargearFallback = true } = Astro.props;

function signed(value: number): string {
  return value > 0 ? `+${value}` : `${value}`;
}
---

{
  showWargearFallback && wargearOptions.length > 0 && (
    <section class="wargear-section">
      <h2>{strings.headings.wargearOptions}</h2>
      <div class="table-scroll">
        <table class="wargear">
          <thead>
            <tr>
              <th scope="col">{strings.headings.wargearOptions}</th>
              <th scope="col">{strings.labels.pointsDelta}</th>
            </tr>
          </thead>
          <tbody>
            {wargearOptions.map((option) => (
              <tr data-wargear={option.id} data-wargear-delta={option.pointsDelta}>
                <th scope="row">{option.name}</th>
                <td class="mono">{signed(option.pointsDelta)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )
}
