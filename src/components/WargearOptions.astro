---
// AI-Assisted: Claude Code (model: Claude Sonnet 5) - The full wargear option structure
// (005-rules-web-enrichment-display task T009; spec.md FR-006, FR-007, FR-008, US1 scenarios 2
// and 3).
//
// AI-Assisted note (model: Claude Sonnet 5, loadout-rendering-conformance branch): this component
// no longer authors its own sentences. It renders rendering-contract.md v1.0.0's Wargear Options
// block (`renderOptionsBlock`, fed by `assembleOptionsInput`) - the option-group sentences/dash
// lists (contract §3.4, §4.3, §4.4, §4.5, nested per §6) AND the item-constraint lines (§3.5, §4.6)
// that this component never showed before. The prose-composition-wargear branch's own per-group
// sentence templates (`multipleChoicePrefix`/`singleChoicePrefix`) and its `WargearChoiceLine`
// sub-component are gone: the contract's decision tables now own every word here, proven
// byte-identical against the vendored conformance corpus (test/rendering-conformance.test.ts).
// `is_default` and `points_delta` are deliberately absent from every template (contract §4.4's own
// note) - `WargearChoiceLine` existed only to show that points figure, so nothing replaces it.
//
// This component still renders nothing for a datasheet with no option groups and no item
// constraints (FR-009's flat-table fallback is still the unit page's decision, keyed on
// `optionGroups.length === 0`, which is unaffected by this rewrite).
import strings from '../chrome-strings.json';
import LoadoutLines from './LoadoutLines.astro';
import { assembleOptionsInput } from '../data/assemble-loadout.ts';
import { renderOptionsBlock } from '../data/loadout-render.ts';

interface Props {
  datasheetId: string;
}

const { datasheetId } = Astro.props;

const options = renderOptionsBlock(assembleOptionsInput(datasheetId));
---

{
  options.lines.length > 0 && (
    <section class="wargear-section" data-wargear-options>
      <h2>{strings.headings.wargearOptions}</h2>
      <LoadoutLines lines={options.lines} dataAttr="wargear-line" />
    </section>
  )
}
