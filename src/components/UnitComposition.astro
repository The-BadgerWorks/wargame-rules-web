---
// AI-Assisted: Claude Code (model: Claude Sonnet 5) - Starting unit composition
// (005-rules-web-enrichment-display task T008; spec.md FR-004, FR-005, US1 scenarios 1 and 4).
//
// AI-Assisted note (model: Claude Sonnet 5, prose-composition-wargear branch): reworked from a
// two-column min/max table into count-first prose lines ("1 Terminator Squad Leader",
// "4-9 Terminators"), and absorbed the unit-size cost rows CostTable used to render as its own
// "Points" table - this is now the one place a reader looks for "what is this unit made of and
// what does it cost", per the operator's readability request. CostTable keeps the cost-bearing
// wargear fallback only.
//
// AI-Assisted note (model: Claude Sonnet 5, loadout-rendering-conformance branch): the composition
// lines above are now rendered by rendering-contract.md v1.0.0's Unit Composition block
// (`renderCompositionBlock`, fed by `assembleCompositionInput`) instead of this component's own
// ad-hoc prose - the FROZEN contract owns the model-line and equipped-with-default-equipment
// wording now, proven byte-identical against the vendored conformance corpus
// (test/rendering-conformance.test.ts). The unit-size points lines below remain exactly as the
// prose-composition-wargear branch left them: they are this site's own addition, not contract
// material (the contract's templates never mention points), so they keep rendering from
// `costs`/`tiers` unchanged and stay positioned clearly after the composition block.
//
// AI-Assisted note (model: Claude Sonnet 5, bugfix on loadout-rendering-conformance): a real-bundle
// operator report showed two "5 models" rows with different points and no way to tell them apart.
// The prose-composition-wargear branch's removal of a separate copy-index column assumed a cost
// tier's own `label` already said "third copy onward" in words - true of the ENRICHED TEST FIXTURE
// only, not of the real bundle, whose tier labels are plain ("5 models") with the escalation
// carried solely in `copyIndexMin`. A row with `copyIndexMin > 1` now appends the qualifier itself
// (", copy {n} onwards"); a `copyIndexMin` of 1 (the common case) is unaffected. No ordinal-suffix
// logic ("3rd") - the copy index is a plain cardinal number, in its own span like every other
// bundle number on this page.
import strings from '../chrome-strings.json';
import LoadoutLines from './LoadoutLines.astro';
import { assembleCompositionInput } from '../data/assemble-loadout.ts';
import { renderCompositionBlock } from '../data/loadout-render.ts';
import type { DatasheetCost, DatasheetCostTier } from '../data/bundle.ts';

interface Props {
  datasheetId: string;
  costs: readonly DatasheetCost[];
  tiers: readonly DatasheetCostTier[];
}

const { datasheetId, costs, tiers } = Astro.props;

const composition = renderCompositionBlock(assembleCompositionInput(datasheetId));

interface SizeRow {
  key: string;
  label: string;
  points: number;
  copyIndexMin: number;
  pricingConfidence: DatasheetCost['pricingConfidence'];
}

const sizeRows: SizeRow[] =
  tiers.length > 0
    ? tiers.map((tier) => ({
        key: `${tier.modelCount}-${tier.copyIndexMin}`,
        label: tier.label,
        points: tier.points,
        copyIndexMin: tier.copyIndexMin,
        pricingConfidence: tier.pricingConfidence,
      }))
    : costs.map((cost) => ({
        key: `${cost.modelCount}-1`,
        label: cost.label,
        points: cost.points,
        copyIndexMin: 1,
        pricingConfidence: cost.pricingConfidence,
      }));

const anyUnverified = sizeRows.some((row) => row.pricingConfidence === 'unverified');
---

{
  (composition.lines.length > 0 || sizeRows.length > 0) && (
    <section class="composition-section" data-composition-section>
      <h2>{strings.headings.composition}</h2>

      {composition.lines.length > 0 && <LoadoutLines lines={composition.lines} dataAttr="composition-line" />}

      {
        sizeRows.length > 0 && (
          <>
            <h3>{strings.headings.points}</h3>
            <ul class="composition-size-list">
              {sizeRows.map((row) => (
                <li
                  class="composition-size-line"
                  data-cost={row.key}
                  data-cost-points={row.points}
                  data-cost-confidence={row.pricingConfidence}
                >
                  <span>{row.label}{row.copyIndexMin > 1 && (<>{strings.prose.copyOnwardsPre}<span class="mono">{row.copyIndexMin}</span>{strings.prose.copyOnwardsPost}</>)}</span>
                  <span class="mono">{strings.prose.pointsOpen}{row.points} {strings.prose.pointsSuffix}</span>
                  {row.pricingConfidence === 'unverified' && (
                    <span class="flag flag--unverified">{strings.labels.unverifiedPricing}</span>
                  )}
                </li>
              ))}
            </ul>
            {anyUnverified && <p class="cost-note">{strings.labels.unverifiedPricingNote}</p>}
          </>
        )
      }
    </section>
  )
}
