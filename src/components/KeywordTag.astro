---
// AI-Assisted: Claude Code (model: Claude Sonnet 5) - One keyword tag, glossary-aware
// (005-rules-web-enrichment-display tasks T015/T016; spec.md FR-010 through FR-014, US2
// acceptance scenarios 1-5; contracts/render-contract.md sections 2-3).
//
// Used by both the unit page's keyword list and WeaponTable's ability-keyword list, so the two
// places a keyword can appear cannot resolve it differently. Every prop below preserves each call
// site's EXISTING <li> markup exactly (class, and the bare `data-keyword` marker the unit keyword
// list already carried) - this component changes only what goes INSIDE the <li>.
//
// When `resolveGlossary` finds no entry, the content is the keyword text alone: no <details>, no
// `data-keyword-glossary` attribute, no tabindex - the render contract's "exactly as today" case
// (FR-012). When it does, the content becomes a native <details>/<summary> disclosure. Native HTML
// is the whole reason this design works with no script at all: click/tap toggles it, Enter/Space
// toggles it while <summary> is focused, and <summary> is focusable without adding a tabindex -
// three of the four required triggers (research.md section 2), and why SC-007 (zero pointer-only
// interactions) holds even if the enhancement script below never loads.
//
// AI-Assisted note (model: Claude Sonnet 5, cursor-hover-keyword-tooltip branch): hover no longer
// opens this <details> in place. It now shows a cursor-anchored floating preview instead, so a
// reader skimming past several keywords is not left with a trail of expanded boxes shifting the
// page underneath them. Click, tap, keyboard, and the no-JS fallback are all UNCHANGED - they still
// exercise the native disclosure below exactly as before; only the hover trigger's presentation
// moved out of the document flow.
import { resolveGlossary } from '../data/glossary.ts';

interface Props {
  text: string;
  wrapperClass?: string;
  /** Reproduces the unit keyword list's pre-existing bare `data-keyword` marker; weapon ability
   *  keywords never carried one, so this defaults to false. */
  markKeyword?: boolean;
}

const { text, wrapperClass, markKeyword = false } = Astro.props;
const entry = resolveGlossary(text);
---

<li class={wrapperClass} data-keyword={markKeyword ? true : undefined}>
  {
    entry ? (
      <details data-keyword-glossary={entry.keywordKey}>
        <summary>{text}</summary>
        <p class="keyword-glossary__summary">{entry.summary}</p>
      </details>
    ) : (
      text
    )
  }
</li>

<script>
  // Bundled (not is:inline), matching UnitFilter.astro's convention. Astro includes and runs a
  // component's script once per page even when the component is used many times, so this runs
  // once regardless of how many keyword tags the page renders - which is also why the floating
  // preview element below is created exactly once per page, not once per keyword.
  //
  // This is a pure ENHANCEMENT over the native toggle in the markup above: it adds a hover
  // trigger (FR-010) and Escape-to-close (render-contract.md section 3). Blocking this script
  // narrows the interaction to click/tap and keyboard - it never removes them, the same fails-open
  // posture UnitFilter.astro established for its own script (research.md section 2's documented,
  // accepted no-JS degradation). With no script, no floating element exists at all; the native
  // <details> is the whole interaction, exactly as it was before this change.
  //
  // Hover no longer opens the <details> in place (cursor-hover-keyword-tooltip). Instead it shows
  // one shared, cursor-anchored preview box, reusing the summary text already sitting in the
  // details' own <p> - no second copy of the bundle text is introduced anywhere, attribute or
  // otherwise, so there is nothing here for the content-boundary scan to miss.
  const tooltips = document.querySelectorAll<HTMLDetailsElement>('[data-keyword-glossary]');

  if (tooltips.length > 0) {
    // "hover" here means a real pointing device, not a touch tap that a browser simulates into a
    // mouse-event sequence - touch devices must never see this floating box (design decision).
    const hoverCapable = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    const tip = document.createElement('div');
    tip.className = 'keyword-float-tip';
    // The <details>/<summary> disclosure already exposes this same text to assistive tech when
    // opened; this floating copy is a purely visual convenience for a pointing-device hover and
    // must not be exposed a second time.
    tip.setAttribute('aria-hidden', 'true');
    tip.hidden = true;
    document.body.append(tip);

    const CURSOR_OFFSET_PX = 14;
    const VIEWPORT_MARGIN_PX = 4;

    function positionTip(clientX: number, clientY: number): void {
      const { width, height } = tip.getBoundingClientRect();

      let left = clientX + CURSOR_OFFSET_PX;
      let top = clientY + CURSOR_OFFSET_PX;

      // Flip above/left when the default below-right placement would run off the viewport.
      if (left + width > window.innerWidth - VIEWPORT_MARGIN_PX) {
        left = clientX - CURSOR_OFFSET_PX - width;
      }
      if (top + height > window.innerHeight - VIEWPORT_MARGIN_PX) {
        top = clientY - CURSOR_OFFSET_PX - height;
      }

      tip.style.left = `${Math.max(VIEWPORT_MARGIN_PX, left)}px`;
      tip.style.top = `${Math.max(VIEWPORT_MARGIN_PX, top)}px`;
    }

    for (const details of tooltips) {
      const summary = details.querySelector('summary');
      if (!summary) continue;

      summary.addEventListener('mouseenter', (event) => {
        // A user who has clicked/tapped this open has pinned the disclosure; showing the floating
        // copy over it too would put the same text on screen twice (design decision).
        if (!hoverCapable || details.open) return;

        const summaryText = details.querySelector('.keyword-glossary__summary')?.textContent;
        if (!summaryText) return;

        tip.textContent = summaryText;
        tip.hidden = false;
        positionTip(event.clientX, event.clientY);
      });

      summary.addEventListener('mousemove', (event) => {
        if (tip.hidden) return;
        positionTip(event.clientX, event.clientY);
      });

      summary.addEventListener('mouseleave', () => {
        tip.hidden = true;
      });

      // Covers both directions: opening while still hovered hides the (now redundant) floating
      // copy immediately, and closing again does not resurrect it uninvited.
      details.addEventListener('toggle', () => {
        if (details.open) tip.hidden = true;
      });

      details.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && details.open) {
          details.open = false;
          summary.focus();
        }
      });
    }
  }
</script>
