---
// AI-Assisted: Claude Code (model: claude-opus-5) - Category flags (task T029; FR-015, US2
// acceptance scenario 8).
//
// FR-015 requires these on "both unit listings and the unit's own page", so the mapping from the
// datasheet's boolean columns to the authored flag names lives here once. Two pages deriving the
// same badges independently is how a listing and a datacard come to disagree.
//
// A Legends unit is badged, never hidden or filtered out: spec.md's Edge Cases are explicit that it
// stays in the faction's unit list and is visibly labelled.
import strings from '../chrome-strings.json';
import type { Datasheet } from '../data/bundle.ts';
import { flagsOf } from '../data/flags.ts';

interface Props {
  datasheet: Datasheet;
}

const { datasheet } = Astro.props;

// The vocabulary itself lives in src/data/flags.ts (task T034), because the filter's category
// options (FR-017) must offer exactly the keys these badges carry. Two independent lists would let
// an option exist that matches no row.
const badges = flagsOf(datasheet);
---

{
  badges.length > 0 && (
    <span class="flag-badges">
      {badges.map((badge) => (
        <span class="flag" data-flag={badge.key}>
          {strings.flags[badge.stringKey]}
        </span>
      ))}
    </span>
  )
}
