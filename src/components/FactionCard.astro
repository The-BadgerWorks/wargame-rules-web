---
// AI-Assisted: Claude Code (model: claude-opus-5) - One faction's entry on the faction index
// (task T021; FR-003, US1 acceptance scenario 1).
//
// The parent-faction line is rendered here rather than by grouping the index into nested lists:
// spec.md's Edge Cases require the parent relationship to be "visible, not merely implied by
// grouping", and research D1 records that a sub-faction is a peer in the index and owns its own
// detachments and units rather than being folded into its parent.
//
// Every string is a bundle value or a chrome-strings key; there is no prose literal in this file.
import strings from '../chrome-strings.json';
import { factionHref, parentFactionOf, type Faction } from '../data/bundle.ts';
import { factionCode } from '../data/slugs.ts';

interface Props {
  faction: Faction;
}

const { faction } = Astro.props;
const parent = parentFactionOf(faction);
---

<li class="faction-card" data-faction={factionCode(faction.code)}>
  <a class="faction-card__name" href={factionHref(faction)}>{faction.name}</a>

  {
    parent && (
      <p class="faction-card__parent" data-parent-faction={factionCode(parent.code)}>
        <span class="meta-label">{strings.headings.parentFaction}</span>
        <a href={factionHref(parent)}>{parent.name}</a>
      </p>
    )
  }
</li>
