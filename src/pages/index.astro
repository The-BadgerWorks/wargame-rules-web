---
// AI-Assisted: Claude Code (model: claude-opus-5) - The faction index, the site's entry point
// (task T021; FR-003, US1 acceptance scenario 1).
// AI-Assisted note (model: claude-sonnet-5, PO review finding 2026-08-05): the index now renders
// one card per TOP-LEVEL faction (`topLevelFactions`) rather than one per faction in the bundle. A
// sub-faction still reaches the index and is still named on it - FR-003's completeness requirement
// - but nested under its parent's card (FactionCard -> SubFactionList) rather than as a peer entry,
// per the product owner's 2026-08-05 decision on Space Marines' Chapters.
//
// The list is already sorted by name at module scope in src/data/bundle.ts, so no ordering decision
// is taken per page.
import BaseLayout from '../layouts/BaseLayout.astro';
import FactionCard from '../components/FactionCard.astro';
import strings from '../chrome-strings.json';
import { topLevelFactions } from '../data/bundle.ts';
---

<BaseLayout title={strings.site.name}>
  <h1>{strings.headings.factions}</h1>
  <p class="lede">{strings.site.tagline}</p>

  <ul class="faction-list">
    {topLevelFactions.map((faction) => <FactionCard faction={faction} />)}
  </ul>
</BaseLayout>
